# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# OS files
.DS_Store
Thumbs.db

# Virtual environments
.venv/
venv/
env/
ENV/

# Project-specific temporary uploads (except .gitkeep)
temp_uploads/*
!temp_uploads/.gitkeep

# Node modules and built frontend assets (git inherits nested gitignores, but good to define here too)
frontend/node_modules/
frontend/*.local
